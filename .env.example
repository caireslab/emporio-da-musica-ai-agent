# ============================================================================
# EMPÓRIO DA MÚSICA AI AGENT — CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha a chave do provedor escolhido.
# ============================================================================

# Provedor de LLM: "gemini" (padrão recomendado), "openai" ou "groq"
LLM_PROVIDER=gemini

# Modelo específico (se vazio, usa o default otimizado de cada provedor):
# - gemini: gemini-2.5-flash (ou gemini-2.0-flash)
# - openai: gpt-4o-mini (ou gpt-4o)
# - groq:   llama-3.3-70b-versatile
LLM_MODEL=gemini-2.5-flash

# Temperatura do modelo (0.1 recomendado para alta fidelidade factual com tom natural)
LLM_TEMPERATURE=0.1

# Chaves de API (preencha apenas a do provedor selecionado acima)
GEMINI_API_KEY=sua_chave_google_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui
GROQ_API_KEY=sua_chave_groq_aqui

# Data de referência operacional para cálculo de prazos de troca/devolução (YYYY-MM-DD)
# Os pedidos do dataset ocorrem até 2026-03-22; 2026-03-25 permite testar pedidos dentro e fora do prazo.
STORE_REFERENCE_DATE=2026-03-25
